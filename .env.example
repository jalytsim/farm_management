# EUDR / TRACES web service (the WS login decides which operator a DDS is filed under)
EUDR_USERNAME=
EUDR_AUTH_KEY=
EUDR_CLIENT_ID=eudr-repository
# Expected operator identifiers, checked by GET /api/eudr/identity-check
EUDR_OPERATOR_NAME=AGRIYIELDS ENTERPRISES UG SMC LTD
EUDR_OPERATOR_EORI=HRUG000004679
EUDR_OPERATOR_TIN=1043535141
EUDR_OPERATOR_CBR=8003457050645
EUDR_OPERATOR_WS_IDENTIFIER=UGhPT7Jq
# Pays de l'opérateur du compte WS : hors UE → seule l'activité IMPORT est proposée/acceptée
EUDR_OPERATOR_COUNTRY=UG
# true seulement si le compte TRACES a le rôle "representative" (sinon EUDR-WEBSERVICE-USER-ACTIVITY-NOT-ALLOWED)
EUDR_ALLOW_REPRESENTATIVE=false
# En-tête BodyIdentity (Web Service Access Identifier) : laisser vide, "UGhPT7Jq" → UnauthenticatedException
EUDR_OPERATOR_ACCESS_IDENTIFIER=
